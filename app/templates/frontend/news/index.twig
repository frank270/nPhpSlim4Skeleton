{% extends "frontend/master-layout03.twig" %}

{% block title %}最新消息 - 1fBreakFast{% endblock %}

{% block hero %}
<!-- Hero Area Start -->
        <section class="hero-area-three pt-250 pb-220 rpb-100 rel z-1" style="background-image: url(/assets/wellfood/assets/images/background/hero-three.png)">
           <span class="marquee-wrap style-two text-white">
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
            </span>
            <div class="container">
                <div class="row align-items-end">
                    <div class="col-lg-6">
                        <div class="hero-content-three mt-250 rmt-0 rmb-55 text-white" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <h1>壹樓早餐</h1>
                            <p>愛美味 吃壹樓</p>
                            <a href="https://www.yovvip.com/ORD/ORDStores?appbar=f&c=MzM1" class="theme-btn style-two">現在就點餐 <i class="far fa-arrow-alt-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-three-image">
                            <img src="/upload/website/p.1_773x620.png" alt="Hero">
                            <div class="offer-badge" style="background-image: url(/assets/wellfood/assets/images/shapes/offer-circle-shape.png)">
                                <span>50% <br>off</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
{% endblock %}

{% block content %}
<!-- Food Category Area start -->
<section class="food-category-area rpb-65 rel z-1">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-7 col-lg-9">
                <div class="section-title text-center mb-50" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                    <span class="sub-title mb-5">Menu</span>
                    <h2>美味餐點</h2>
                </div>
            </div>
        </div>

    </div>

</section>
<!-- Food Category Area end -->
<!-- Gallery Area start -->
<section class="photo-gallery-area rpt-100 pb-60 rpb-30 rel z-1">
    <div class="container">
        <ul class="nav gallery-nav food-menu-tab mb-40" role="tablist" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
            <li>
                <button class="nav-link active" data-filter=".event">
                    <i class="flaticon-cupcake"></i>
                    <span>活動新品</span>
                </button>
            </li>
            <li>
                <button class="nav-link" data-filter=".store">
                    <i class="flaticon-broccoli"></i>
                    <span>展店消息</span>
                </button>
            </li>
            <li>
                <button class="nav-link" data-filter=".member">
                    <i class="flaticon-fried-potatoes"></i>
                    <span>會員活動</span>
                </button>
            </li>
            
        </ul>
        
        <div class="row gallery-active">
        {% for post in posts %}
            <div class="col-lg-4 col-sm-6 item {{ '活動新品' in post.tags ? 'event' : '' }} {{ '展店消息' in post.tags ? 'store' : '' }} {{ '會員活動' in post.tags ? 'member' : '' }}">
                <div class="gallery-item-three" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                    <a href="/news/{{ post.slug }}">
                        <img src="{{ post.cover_image }}" alt="{{ post.title }}">
                    </a>
                    <h3><a href="/news/{{ post.slug }}">{{ post.title }}</a></h3>
                    <span class="category">{{post.tags}}</span>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center">
                <p>目前尚無最新消息。</p>
            </div>
        {% endfor %}    
        </div>
        {% if totalPages > 1 %}
        <div class="row">
            <div class="col-lg-12">
                <div class="pagination-wrap text-center mt-10">
                    <ul class="pagination">
                        {# 簡單的分頁邏輯 #}
                        {% for i in 1..totalPages %}
                        <li class="page-item {{ i == currentPage ? 'active' : '' }}">
                            <a class="page-link" href="?page={{ i }}">{{ i }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</section>
<!-- Gallery Area end -->

{% endblock %}
