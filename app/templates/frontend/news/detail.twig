{% extends "frontend/master-layout03.twig" %}

{% block title %}{{ post.title }} - 最新消息 - 1fBreakFast{% endblock %}

{% block styles %}
<style>
    /* Quill Content Styling for Frontend */
    .blog-details-content img {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin: 20px 0;
    }
    .blog-details-content iframe {
        max-width: 100%;
        width: 100%;
        aspect-ratio: 16/9;
    }
    .ql-align-center {
        text-align: center;
    }
    .ql-align-right {
        text-align: right;
    }
    .ql-align-justify {
        text-align: justify;
    }
    blockquote {
        border-left: 4px solid #ccc;
        margin-bottom: 5px;
        margin-top: 5px;
        padding-left: 16px;
    }
</style>
{% endblock %}

{% block hero %}
<section class="page-banner-area pt-200 rpt-140 pb-100 rpb-60 rel z-1" style="background-image: url(/assets/wellfood/assets/images/background/hero-three.png)">
    <div class="container">
        <div class="banner-inner text-white">
            <h1 class="page-title wow fadeInUp delay-0-2s">{{ post.title }}</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center wow fadeInUp delay-0-4s">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/news">最新消息</a></li>
                    <li class="breadcrumb-item active">{{ post.title }}</li>
                </ol>
            </nav>
        </div>
    </div>
</section>
{% endblock %}

{% block content %}
<section class="blog-details-area py-130 rpy-100">
    <div class="container container-1290">
        <div class="row">
            <div class="col-lg-8">
                <div class="blog-details-wrap">
                    <div class="blog-item style-two">
                        {% if post.cover_image %}
                        <div class="image" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <img src="{{ post.cover_image starts with 'http' ? post.cover_image : '' ~ post.cover_image }}" alt="{{ post.title }}">
                        </div>
                        {% endif %}
                        
                        <div class="content" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <ul class="blog-meta-two">
                                <li>
                                    <a href="#">壹樓早餐</a>
                                </li>
                                <li>
                                    <a href="#">{{ post.published_at|date("F d, Y") }}</a>
                                </li>
                                {# <li><a href="#">comments (0)</a></li> #}
                            </ul>
                            <h3><a href="javascript:void(0);">{{ post.title }}</a></h3>
                            
                            <!-- Quill Content -->
                            <div class="blog-content-body">
                                {{ post.content|raw }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="tag-share">
                        <div class="item" data-aos="fade-left" data-aos-duration="1500" data-aos-offset="50">
                            <h6>Tags : </h6>
                            <div class="tags">
                                {% if post.tags %}
                                    {% for tag in post.tags|split(',') %}
                                    <a href="#">{{ tag }}</a>
                                    {% endfor %}
                                {% else %}
                                    <a href="#">News</a>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="item" data-aos="fade-right" data-aos-duration="1500" data-aos-offset="50">
                            <h6>Share News</h6>
                            <div class="social-style-one">
                                <a href="#"><i class="fab fa-twitter"></i></a>
                                <a href="#"><i class="fab fa-facebook-f"></i></a>
                                <a href="#"><i class="fab fa-instagram"></i></a>
                                <a href="#"><i class="fab fa-pinterest-p"></i></a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="next-prev-blog pt-45 pb-15">
                        <div class="item" data-aos="fade-left" data-aos-duration="1500" data-aos-offset="50">
                             <a href="/news" class="theme-btn style-two"><i class="far fa-arrow-left"></i> 返回最新消息</a>
                        </div>
                    </div>
                    
                </div>
            </div>
            
            <!-- Sidebar -->
            <div class="col-lg-4 col-md-8">
                <div class="main-sidebar rmt-75">
                    <div class="widget widget-search" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                        <h4 class="widget-title">Search</h4>
                        <form action="/news" class="default-search-form">
                            <input type="text" name="keyword" placeholder="Search here" required>
                            <button type="submit" class="searchbutton far fa-search"></button>
                        </form>
                    </div>
                    
                    <div class="widget widget-category" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
                        <h4 class="widget-title">Category</h4>
                        <ul>
                            <li><a href="/news">全部消息</a></li>
                            <li><a href="/news?filter=event">活動新品</a></li>
                            <li><a href="/news?filter=store">展店消息</a></li>
                            <li><a href="/news?filter=member">會員活動</a></li>   
                            {# 這裡可以之後做分類統計 #}
                        </ul>
                    </div>
                    
                    
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
