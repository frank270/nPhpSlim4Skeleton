{% extends "frontend/master-layout03.twig" %}

{% block title %}{{ item.name }} - 1fBreakFast{% endblock %}

{% block hero %}
<!-- Page Banner Start -->
<section class="page-banner-area overlay pt-250 pb-50 rel z-1" style="background-image: url(/assets/wellfood/assets/images/banner/hero-banner.jpg)">
    <div class="container">
        <div class="banner-inner text-white">
            <h1 class="page-title mb-10" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">商品詳情</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1500" data-aos-offset="50">
                    <li class="breadcrumb-item"><a href="/">首頁</a></li>
                    <li class="breadcrumb-item"><a href="/menu">菜單</a></li>
                    <li class="breadcrumb-item active">{{ item.name }}</li>
                </ol>
            </nav>
        </div>
    </div>
</section>
<!-- Page Banner End -->
{% endblock %}

{% block content %}
<!-- Product Details Start -->
<section class="product-details pb-10 pt-130 rpt-100">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="product-details-image rmb-55" data-aos="fade-left" data-aos-duration="1500" data-aos-offset="50">
                    {% if item.image_path %}
                    <img src="{{ item.image_path starts with 'http' ? item.image_path : '/' ~ item.image_path }}" alt="{{ item.name }}" style="width: 100%; object-fit: cover;">
                    {% else %}
                    <img src="/assets/wellfood/assets/images/products/product-details.jpg" alt="Default Image">
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-6">
                <div class="product-details-content" data-aos="fade-right" data-aos-duration="1500" data-aos-offset="50">
                    <div class="section-title">
                        <h2>{{ item.name }}</h2>
                    </div>
                    <span class="price mb-15">
                        {% if item.price_sale %}
                            <del class="text-muted" style="font-size: 0.7em;">${{ item.price_original|round }}</del> 
                            <span class="text-danger">${{ item.price_sale|round }}</span>
                        {% else %}
                            ${{ item.price_original|round }}
                        {% endif %}
                    </span>
                    
                    <div class="ratting mb-40">
                       {# Rating placeholder #}
                       <i class="fas fa-star"></i>
                       <i class="fas fa-star"></i>
                       <i class="fas fa-star"></i>
                       <i class="fas fa-star"></i>
                       <i class="fas fa-star"></i>
                       <span>(New)</span>
                    </div>

                    <p>{{ item.description|nl2br }}</p>

                    {# Add to cart form removed. Just simple info or contact button optionally #}
                    
                    <ul class="category-tags pt-20 pb-30">
                        <li>
                            <h6>分類</h6> :
                            <a href="/menu?category_id={{ item.category_id }}">{{ item.category_name }}</a>
                        </li>
                        {% if item.tags %}
                        <li>
                            <h6>標籤 </h6> :
                            {% for tag in item.tags|split(',') %}
                            <a href="/menu?keyword={{ tag }}">{{ tag }}</a>
                            {% endfor %}
                        </li>
                        {% endif %}
                    </ul>
                    
                    {# Social share or other widgets #}
                    <div class="social-style-one">
                        <h5>分享</h5>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-line"></i></a>
                    </div>
                </div>
            </div>
        </div>
        
        {# Optional Tabs for Description/Reviews, can be simple for now #}
        
    </div>
</section>
<!-- Product Details End -->
{% endblock %}
