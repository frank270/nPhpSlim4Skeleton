{% block content %}
<!-- Contact Area Start -->
<section class="contact-area py-130 rpy-100 rel z-1">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="contact-left-content rmb-55" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                    <div class="section-title mb-30">
                        <span class="sub-title mb-5">CONTACT US</span>
                        <h2>聯絡我們</h2>
                    </div>
                    <p>如果您有任何問題或建議，歡迎隨時與我們聯繫。我們將竭誠為您服務。</p>
                    
                    <div class="contact-info-item style-two">
                        <div class="icon">
                            <i class="flaticon-location"></i>
                        </div>
                        <div class="content">
                            <h5>地址 Locations</h5>
                            <div class="text">242 新北市新莊區中正路514巷105弄18號1樓</div>
                        </div>
                    </div>
                    
                    <div class="contact-info-item style-two">
                        <div class="icon">
                            <i class="flaticon-email"></i>
                        </div>
                        <div class="content">
                            <h5>信箱 Email</h5>
                            <div class="text"><a href="mailto:1fbreakfastsrever@gmail.com">1fbreakfastsrever@gmail.com</a></div>
                        </div>
                    </div>
                    
                    <div class="contact-info-item style-two">
                        <div class="icon">
                            <i class="flaticon-phone-call"></i>
                        </div>
                        <div class="content">
                            <h5>電話 Phone</h5>
                            <div class="text">
                                壹樓總部 | <a href="tel:0229015001">(02)2901-5001</a><br>
                                客服電話 | <a href="tel:0800030909">0800-030-909</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="contact-form-wrap form-style-two bg-white p-50 br-5 shadow-lg" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
                    <div class="section-title mb-30">
                        <h3>聯絡我們</h3>
                        <p>您的電子信箱不會被公開。 必填欄位標記 *</p>
                    </div>
                    <form id="contactForm" class="contact-form" name="contactForm" action="#" method="post">
                        <div class="row clearfix">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="text" name="name" class="form-control" placeholder="姓名" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="email" name="email" class="form-control" placeholder="電子信箱" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="text" name="phone" class="form-control" placeholder="聯絡電話" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="text" name="subject" class="form-control" placeholder="主旨" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <textarea name="message" class="form-control" rows="5" placeholder="訊息內容" required></textarea>
                                </div>
                            </div>
                            <div class="col-md-6 mb-20">
                                <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                                    <label for="captcha" style="white-space: nowrap; margin-bottom: 0; font-weight: bold;">驗證碼 ({{ captcha_question }}):</label>
                                    <input type="text" name="captcha" id="captcha" class="form-control" placeholder="請輸入答案" required style="width: 120px;">
                                </div>
                            </div>
                            <div class="col-md-12">
                                <button type="submit" class="theme-btn style-two">送出訊息 <i class="far fa-arrow-alt-right"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="contact-shapes" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; overflow: hidden;">
        <div class="shape one" style="position: absolute; left: -5%; bottom: 10%; max-width: 250px;">
            <img src="/assets/wellfood/assets/images/shapes/tomato.png" alt="Shape" style="width: 100%;">
        </div>
        <div class="shape two" style="position: absolute; right: -5%; top: 5%; max-width: 300px;">
            <img src="/assets/wellfood/assets/images/shapes/burger.png" alt="Shape" style="width: 100%;">
        </div>
    </div>
</section>
<!-- Contact Area End -->

<!-- Map Area Start -->
<div class="contact-map-area">
    <div class="contact-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3615.002773200782!2d121.4194!3d25.0339!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3442a7dd8bed073f%3A0x6b1c430b20111111!2zMjQy5paw5YyX5biC5paw6IuW5Y2A5Lit5q2j6LevNTE05be3MTA15byEMTromZ8xZg!5e0!3m2!1szh-TW!2stw!4v1625000000000!5m2!1szh-TW!2stw" 
            style="border:0; width: 100%; height: 500px;" 
            allowfullscreen="" 
            loading="lazy">
        </iframe>
    </div>
</div>
<!-- Map Area End -->

<style>
    .form-control {
        border: 1px solid #e5e5e5;
        background-color: #f8f8f8;
        padding: 15px 20px;
        border-radius: 5px;
        color: #666;
        font-weight: 400;
        transition: all 0.3s ease;
    }
    .form-control:focus {
        border-color: #ff8e28; /* Primary/Secondary color */
        background-color: #fff;
        box-shadow: none;
    }
</style>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contactForm');
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;
        
        // Disable button and show loading
        submitBtn.disabled = true;
        submitBtn.innerHTML = '傳送中...';
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        fetch('/contact/submit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams(formData).toString()
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                Swal.fire({
                    title: '發送成功',
                    text: result.message,
                    icon: 'success',
                    confirmButtonText: '確定',
                    confirmButtonColor: '#ff8e28'
                });
                form.reset();
            } else {
                throw new Error(result.message || '發生未知錯誤');
            }
        })
        .catch(error => {
            Swal.fire({
                title: '發送失敗',
                text: error.message,
                icon: 'error',
                confirmButtonText: '確定',
                confirmButtonColor: '#ff8e28'
            });
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
        });
    });
});
</script>
{% endblock %}
