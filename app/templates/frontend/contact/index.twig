                    <div class="col-lg-5 align-self-end">
                        <div class="hero-two-right">
                            <span class="hero-title text-end" data-aos="fade-right" data-aos-delay="150" data-aos-duration="1500" data-aos-offset="50" style="font-size: 150px;">{{ short_code('contact_hero_text_right') }}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hero-shapes">
                <div class="shape one">
                    <img src="/assets/wellfood/assets/images/shapes/hero-two.png" alt="Hero Shape">
