                <div class="shape three">
                    <img src="/assets/wellfood/assets/images/shapes/hero-shape3.png" alt="Hero Shape">
                </div>
                <div class="pizza">
                    {{ short_code('contact_hero_image') }}
                </div>
                <div class="letter-shape-one">
                    <img src="/assets/wellfood/assets/images/hero/letter-shape.png" alt="Leter Shape">
                </div>
                <div class="letter-shape-two">
                    <img src="/assets/wellfood/assets/images/hero/letter-shape-two.png" alt="Leter Shape">
