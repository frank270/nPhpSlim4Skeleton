                    <a href="/upload/website/footer_0.p.4_384x400.png"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1500" data-aos-offset="50">
                <div class="instagram-item">
                    <img src="/upload/website/footer_0.p.5_384x400.png" alt="Instagram">
                    <a href="/upload/website/footer_0.p.5_384x400.png"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>
    <!-- Instagram area end -->
{% endblock %}
