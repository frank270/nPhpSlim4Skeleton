{% extends "frontend/master-layout03.twig" %}

{% block title %}
	{{ title }}
	- 1fBreakFast
{% endblock %}

{% block hero %}
	<!-- Page Banner Start -->
	<section class="page-banner-area overlay pb-90 rpb-70 rel z-1 bgs-cover text-center"></section>
	<!-- Page Banner End -->
	<!-- Testimonials Two Area start -->
	<section class="testimonials-two bgc-primary" style="background-image: url(assets/wellfood/assets/images/testimonials/testimonials-two-bg.png);">
		<div class="row align-items-center">
			<div class="col-lg-6">
				<div class="why-choose-two-image">
					{{ short_code('about_intro_image') }}
				</div>
			</div>
			<div class="col-lg-6">
				<div class="testimonials-two-content rel z-1 text-center text-white p-45 rpy-55">
					<div class="section-title mb-20" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
						<span class="sub-title mb-5">{{ short_code('about_intro_subtitle') }}</span>
						<h2>{{ short_code('about_intro_title') }}</h2>
					</div>
					<span class="marquee-wrap style-two">
						<span class="marquee-inner left">review
						</span>
						<span class="marquee-inner left">review
						</span>
						<span class="marquee-inner left">review
						</span>
					</span>
					<div class="testimonials-two-carousel" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
						<div class="testimonial-two-item">
							<div class="quote">
								<i class="flaticon-quote"></i>
							</div>
							<div class="text">{{ short_code('about_intro_text') }}</div>
							<span class="author">{{ short_code('about_intro_author') }}</span>
							<span class="designation">{{ short_code('about_intro_role') }}</span>
						</div>
						{# <div class="testimonial-two-item">
						                            <div class="quote"><i class="flaticon-quote"></i></div>
						                            <div class="text">Renowned for its versatility in the kitchen, Red King Crab can prepared in various ways, from simple steaming or boiling to elaborate preparations such as grilling incorporating weather loving</div>
						                            <span class="author">Salvador I. Burton</span>
						                            <span class="designation">Manager</span>
						                        </div>
						                        <div class="testimonial-two-item">
						                            <div class="quote"><i class="flaticon-quote"></i></div>
						                            <div class="text">Renowned for its versatility in the kitchen, Red King Crab can prepared in various ways, from simple steaming or boiling to elaborate preparations such as grilling incorporating weather loving</div>
						                            <span class="author">Salvador I. Burton</span>
						                            <span class="designation">Manager</span>
						                        </div>
						                        <div class="testimonial-two-item">
						                            <div class="quote"><i class="flaticon-quote"></i></div>
						                            <div class="text">Renowned for its versatility in the kitchen, Red King Crab can prepared in various ways, from simple steaming or boiling to elaborate preparations such as grilling incorporating weather loving</div>
						                            <span class="author">Salvador I. Burton</span>
						                            <span class="designation">Manager</span>
						                        </div> #}
					</div>
					<div class="shape">
						<img src="/assets/wellfood/assets/images/shapes/tomato.png" alt="Shape">
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- Testimonials Two Area end -->
	<!-- Counter Four Area start -->
	<div class="counter-area-four bgs-cover pt-100" style="background-image: url({{ short_code('about_counter_bg') }});">
		<div class="container">
			<div class="row justify-content-end">
				<div class="col-xl-7 col-lg-9">
					<div class="row no-gap">
						<div class="col-lg-4 col-sm-6">
							<div class="counter-item text-white style-four bgc-primary counter-text-wrap" data-aos="fade-down" data-aos-duration="1500" data-aos-offset="50">
								<span class="count-text plus" data-speed="3000" data-stop="{{ short_code('about_counter_1_number') }}">0</span>
								<div class="wave"></div>
								<h6 class="counter-title">{{ short_code('about_counter_1_label') }}</h6>
							</div>
						</div>
						<div class="col-lg-4 col-sm-6">
							<div class="counter-item style-four bgc-secondary counter-text-wrap" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
								<span class="count-text k-plus" data-speed="3000" data-stop="{{ short_code('about_counter_2_number') }}">0</span>
								<div class="wave"></div>
								<h6 class="counter-title">{{ short_code('about_counter_2_label') }}</h6>
							</div>
						</div>
						<div class="col-lg-4 col-sm-6">
							<div class="counter-item style-four counter-text-wrap" data-aos="fade-down" data-aos-delay="100" data-aos-duration="1500" data-aos-offset="50">
								<span class="count-text k-plus" data-speed="3000" data-stop="{{ short_code('about_counter_3_number') }}">0</span>
								<div class="wave"></div>
								<h6 class="counter-title">{{ short_code('about_counter_3_label') }}</h6>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Counter Four Area end -->
{% endblock %}

{% block content %}


	<!-- Headline area start -->
	<div class="headline-area mb-105 rmb-85 rel z-1">
		<span class="marquee-wrap">
			<span class="marquee-inner left">
				<span class="marquee-item">Italian pizza</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">delicious foods</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">burger king</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
			</span>
			<span class="marquee-inner left">
				<span class="marquee-item">Italian pizza</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">delicious foods</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">burger king</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
			</span>
			<span class="marquee-inner left">
				<span class="marquee-item">Italian pizza</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">delicious foods</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
				<span class="marquee-item">burger king</span>
				<span class="marquee-item">
					<i class="flaticon-star"></i>
				</span>
			</span>
		</span>
		<div class="headline-shapes">
			<div class="shape one">
				<img src="/assets/wellfood/assets/images/shapes/tomato.png" alt="Shape">
			</div>
			<div class="shape two">
				<img src="/assets/wellfood/assets/images/shapes/burger.png" alt="Shape">
			</div>
		</div>
	</div>
	<!-- Headline Area end -->

	<!-- History Area start -->
	<section class="history-area pb-130 rpb-100 rel z-1">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-xxl-6 col-xl-7 col-lg-9">
					<div class="section-title text-center mb-50" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
						<span class="sub-title mb-5">{{ short_code('about_history_subtitle') }}</span>
						<h2>{{ short_code('about_history_title') }}</h2>
					</div>
				</div>
			</div>
			<div class="history-wrapper">
				<div class="row no-gap">
					{% for post in posts %}
						{% set isRight = (loop.index is even) %}
						<div class="col-lg-6" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50" {% if isRight %} data-aos-delay="50" {% endif %}>
							<div class="history-item-wrap {% if isRight %}history-right{% endif %}">
								<div class="history-item">
									<div class="image">
										{% if post.cover_image %}
											<img src="{{ post.cover_image }}" alt="{{ post.title }}">
										{% else %}
											<img src="/assets/wellfood/assets/images/history/history{{ (loop.index % 6) + 1 }}.jpg" alt="Default History Image">
										{% endif %}
									</div>
									<div class="content">
										<span class="year">{{ post.published_at ? post.published_at|date('Y') : post.created_at|date('Y') }}</span>
										<h5>{{ post.title }}</h5>
										<div>{{ post.content|raw }}</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</section>
	<!-- History Area end -->
	<!-- Instagram area start -->
	<div class="instagram-area">
		<div class="row no-gap row-cols-xxl-5 row-cols-xl-4 row-cols-lg-3 row-cols-sm-2 row-cols-1 justify-content-center">
			<div class="col" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
				<div class="instagram-item">
					<img src="{{ short_code('shared_instagram_1') }}" alt="Instagram">
					<a href="{{ short_code('shared_instagram_1') }}">
						<i class="fab fa-instagram"></i>
					</a>
				</div>
			</div>
			<div class="col" data-aos="fade-up" data-aos-delay="50" data-aos-duration="1500" data-aos-offset="50">
				<div class="instagram-item">
					<img src="{{ short_code('shared_instagram_2') }}" alt="Instagram">
					<a href="{{ short_code('shared_instagram_2') }}">
						<i class="fab fa-instagram"></i>
					</a>
				</div>
			</div>
			<div class="col" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1500" data-aos-offset="50">
				<div class="instagram-item">
					<img src="{{ short_code('shared_instagram_3') }}" alt="Instagram">
					<a href="{{ short_code('shared_instagram_3') }}">
						<i class="fab fa-instagram"></i>
					</a>
				</div>
			</div>
			<div class="col" data-aos="fade-up" data-aos-delay="150" data-aos-duration="1500" data-aos-offset="50">
				<div class="instagram-item">
					<img src="{{ short_code('shared_instagram_4') }}" alt="Instagram">
					<a href="{{ short_code('shared_instagram_4') }}">
						<i class="fab fa-instagram"></i>
					</a>
				</div>
			</div>
			<div class="col" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1500" data-aos-offset="50">
				<div class="instagram-item">
					<img src="{{ short_code('shared_instagram_5') }}" alt="Instagram">
					<a href="{{ short_code('shared_instagram_5') }}">
						<i class="fab fa-instagram"></i>
					</a>
				</div>
			</div>
		</div>
	</div>
	<!-- Instagram area end -->
{% endblock %}
