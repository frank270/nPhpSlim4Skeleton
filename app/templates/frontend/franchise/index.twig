{% block scripts %}
    {{ parent() }}
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    $(document).ready(function(){
        $('#booking-form').on('submit', function(e){
            e.preventDefault();
            
            var form = $(this);
            var btn = form.find('button[type="submit"]');
            var originalText = btn.html();
            
            // Disable button
            btn.prop('disabled', true).html('傳送中... <i class="fas fa-spinner fa-spin"></i>');
            
            $.ajax({
                url: '/franchise/submit',
                type: 'POST',
                data: form.serialize(),
                dataType: 'json',
                success: function(response){
                    if(response.success){
                        Swal.fire({
                            icon: 'success',
                            title: '成功',
                            text: response.message,
                            confirmButtonColor: '#EC3D08'
                        });
                        form[0].reset();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '錯誤',
                            text: response.message,
                            confirmButtonColor: '#EC3D08'
                        });
                    }
                },
                error: function(xhr){
                    var msg = '發送失敗，請稍後再試。';
                    if(xhr.responseJSON && xhr.responseJSON.message){
                        msg = xhr.responseJSON.message;
                    }
                    Swal.fire({
                        icon: 'error',
                        title: '錯誤',
                        text: msg,
                        confirmButtonColor: '#EC3D08'
                    });
                },
                complete: function(){
                    btn.prop('disabled', false).html(originalText);
                }
            });
        });
    });
    </script>
{% endblock %}
