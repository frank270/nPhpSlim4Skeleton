{% extends "frontend/master-layout03.twig" %}

{% block title %}{{ item.name }} - 1fBreakFast{% endblock %}

{% block hero %}
<!-- Hero Area Start -->
        <section class="hero-area-three pt-250 pb-220 rpb-100 rel z-1" style="background-image: url(/assets/wellfood/assets/images/background/hero-three.png?v=260326)">
           <span class="marquee-wrap style-two text-white">
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
            </span>
            <div class="container">
                <div class="row align-items-end">
                    <div class="col-lg-6">
                        <div class="hero-content-three mt-250 rmt-0 rmb-55 text-white" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <h1>壹樓早餐</h1>
                            <p>愛美味 吃壹樓</p>
                            <a href="https://www.yovvip.com/ORD/ORDStores?appbar=f&c=MzM1" class="theme-btn style-two">現在就點餐 <i class="far fa-arrow-alt-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-three-image">
                            <img src="/upload/website/p.1_773x620.png" alt="Hero">
                            <div class="offer-badge" style="background-image: url(/assets/wellfood/assets/images/shapes/offer-circle-shape.png)">
                                <span>50% <br>off</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
{% endblock %}

{% block content %}
<!-- Food Category Area start -->
        <section class="food-category-area  rpb-65 rel z-1">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-7 col-lg-9">
                        <div class="section-title text-center mb-50" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <span class="sub-title mb-5">Food Safety Report </span>
                            <h2>食品安全檢驗</h2>
                        </div>
                    </div>
                </div>

            </div>

        </section>
        <!-- Food Category Area end -->
<!-- Product Details Start -->
<section class="product-details pb-10  rpt-100 mb-100">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="product-details-image rmb-55" data-aos="fade-left" data-aos-duration="1500" data-aos-offset="50">
                    {% if item.image_path %}
                    <img src="{{ item.image_path starts with 'http' ? item.image_path : '/' ~ item.image_path }}" alt="{{ item.name }}" style="width: 100%; object-fit: cover;">
                    {% else %}
                    <img src="/assets/wellfood/assets/images/products/product-details.jpg" alt="Default Image">
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-6">
                <div class="product-details-content" data-aos="fade-right" data-aos-duration="1500" data-aos-offset="50">
                    <div class="section-title">
                        <h2>{{ item.name }}</h2>
                    </div>
                    
                    <div class="mb-20">
                        <p class="mb-5"><i class="far fa-calendar-alt me-2"></i> 檢驗日期: <strong>{{ item.report_date ? item.report_date : '未標示' }}</strong></p>
                        {% if item.expired_at %}
                        <p class="mb-5"><i class="far fa-clock me-2"></i> 有效期限: <strong>{{ item.expired_at }}</strong></p>
                        {% endif %}
                    </div>

                    <p class="mt-20">{{ item.description|nl2br }}</p>

                    <ul class="category-tags pt-20 pb-30">
                        <li>
                            <h6>分類</h6> :
                            <a href="/food-safety?category_id={{ item.category_id }}">{{ item.category_name }}</a>
                        </li>
                        {% if item.tags %}
                        <li>
                            <h6>標籤 </h6> :
                            {% for tag in item.tags|split(',') %}
                            <a href="/food-safety?keyword={{ tag }}">{{ tag }}</a>
                            {% endfor %}
                        </li>
                        {% endif %}
                    </ul>
                    
                    {% if item.file_path %}
                    <div class="mt-4">
                        <a href="{{ item.file_path starts with 'http' ? item.file_path : '/' ~ item.file_path }}" target="_blank" class="theme-btn style-two">
                            下載檢驗報告 (PDF) <i class="fas fa-download ms-2"></i>
                        </a>
                    </div>
                    {% endif %}
                    
                    <div class="social-style-one mt-4">
                        <h5>分享</h5>
                        <a href="/contact"><i class="fab fa-facebook-f"></i></a>
                        <a href="/contact"><i class="fab fa-line"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Details End -->
{% endblock %}
