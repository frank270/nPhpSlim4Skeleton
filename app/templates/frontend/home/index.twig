{% block scripts %}
<!-- Entry Popup -->
<style>
#entry-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
}
#entry-popup-overlay.visible {
    opacity: 1;
    pointer-events: auto;
}
#entry-popup-inner {
    position: relative;
    transform: scale(0.93);
    transition: transform 0.4s ease;
}
#entry-popup-overlay.visible #entry-popup-inner {
    transform: scale(1);
}
#entry-popup-inner img {
    display: block;
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
}
#entry-popup-close {
    position: absolute;
    top: -18px;
    right: -18px;
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.6);
    border-radius: 50%;
    color: #fff;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
}
#entry-popup-close:hover {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
}
</style>

<div id="entry-popup-overlay">
    <div id="entry-popup-inner">
        <button id="entry-popup-close" aria-label="關閉">&#x2715;</button>
        <img src="/assets/img/home_popup_img.png" alt="公告">
    </div>
</div>

<script>
(function () {
    var KEY = '1f_entry_popup_shown';
    var overlay = document.getElementById('entry-popup-overlay');
    if (sessionStorage.getItem(KEY)) {
        overlay.style.display = 'none';
        return;
    }
    sessionStorage.setItem(KEY, '1');

    setTimeout(function () {
        overlay.classList.add('visible');
    }, 500);

    function close() {
        overlay.classList.remove('visible');
        setTimeout(function () { overlay.style.display = 'none'; }, 400);
    }

    document.getElementById('entry-popup-close').addEventListener('click', close);
    overlay.addEventListener('click', function (e) {
        if (e.target === overlay) close();
    });
})();
</script>
{% endblock %}
