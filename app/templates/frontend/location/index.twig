{% extends "frontend/master-layout03.twig" %}

{% block title %}門市據點 - 1fBreakFast{% endblock %}
{% block hero %}
<!-- Hero Area Start -->
        <section class="hero-area-three pt-250 pb-220 rpb-100 rel z-1" style="background-image: url(/assets/wellfood/assets/images/background/hero-three.png)">
           <span class="marquee-wrap style-two text-white">
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
               <span class="marquee-inner left">1F BREAFAST</span>
            </span>
            <div class="container">
                <div class="row align-items-end">
                    <div class="col-lg-6">
                        <div class="hero-content-three mt-250 rmt-0 rmb-55 text-white" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <h1>壹樓早餐</h1>
                            <p>愛美味 吃壹樓</p>
                            <a href="https://www.yovvip.com/ORD/ORDStores?appbar=f&c=MzM1" class="theme-btn style-two">現在就點餐 <i class="far fa-arrow-alt-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-three-image">
                            <img src="/upload/website/p.1_773x620.png" alt="Hero">
                            <div class="offer-badge" style="background-image: url(/assets/wellfood/assets/images/shapes/offer-circle-shape.png)">
                                <span>50% <br>off</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
{% endblock %}
{% block content %}

<!-- Food Category Area start -->
        <section class="food-category-area  rpb-65 rel z-1">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-7 col-lg-9">
                        <div class="section-title text-center mb-50" data-aos="fade-up" data-aos-duration="1500" data-aos-offset="50">
                            <span class="sub-title mb-5">Locations</span>
                            <h2>門市據點</h2>
                        </div>
                    </div>
                </div>

            </div>

        </section>
        <!-- Food Category Area end -->
    <!-- Checkout Form Area Start -->
        <div class="checkout-form-area  pb-130">
            <div class="container">
                {% if locations is empty %}
                    <p>目前沒有門市資料。</p>
                {% else %}
                {% for location in locations %}
               <div class="checkout-faqs" id="checkout-faqs">
                    
                    <div class="alert bgc-lighter wow fadeInUp delay-0-2s">
                        <h6>{{ location.name }}<a href="javascript:void(0);" class="collapsed card-header" data-bs-toggle="collapse" data-bs-target="#collapse5" aria-expanded="false" aria-controls="collapse5"> {{ location.phone }}</a> {{ location.county }}{{ location.district }} {{ location.zipcode}} {{ location.address }}
                        {% if location.status == 'open' %}營業中
                            {% elseif location.status == 'closed' %}已打烊
                            {% elseif location.status == 'pause' %}暫停營業
                            {% endif %}</h6>
                        
                    </div>

                   
                {% endfor %}
        {% endif %}
            </div>
        </div>
        <!-- Checkout Form Area End -->
{% endblock %}
