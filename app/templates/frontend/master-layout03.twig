		<!-- Custom script -->
		<script src="/assets/wellfood/assets/js/script.js"></script>

		{% block scripts %}{% endblock %}

		<!-- Floating Order Button -->
		<style>
		#float-order-btn {
			position: fixed;
			bottom: 24px;
			right: 24px;
			z-index: 9990;
			width: 140px;
			display: block;
		}
		#float-order-btn a {
			display: block;
			line-height: 0;
		}
		#float-order-btn img {
			width: 140px;
			height: 159px;
			object-fit: contain;
			display: block;
			transition: transform 0.2s ease;
		}
		#float-order-btn img:hover {
			transform: scale(1.03);
		}
		#float-order-close {
			position: absolute;
			top: -10px;
			right: -10px;
			width: 26px;
			height: 26px;
			background: rgba(0,0,0,0.6);
			border: 2px solid rgba(255,255,255,0.6);
			border-radius: 50%;
			color: #fff;
			font-size: 12px;
			line-height: 1;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: background 0.2s;
			z-index: 9991;
		}
		#float-order-close:hover {
			background: var(--primary-color);
			border-color: var(--primary-color);
		}
		/* 手機版 */
		@media (max-width: 575px) {
			#float-order-btn {
				width: 100px;
				bottom: 16px;
				right: 10px;
			}
			#float-order-btn img {
				width: 100px;
				height: 114px;
			}
		}
		</style>

		<div id="float-order-btn">
			<a href="https://www.yovvip.com/ORD/ORDStores?appbar=f&amp;c=MzM1" target="_blank" rel="noopener noreferrer">
				<img src="/assets/img/order_right_now_bb.png" alt="立即訂購">
			</a>
			<button id="float-order-close" aria-label="關閉">&#x2715;</button>
		</div>

		<script>
		document.getElementById('float-order-close').addEventListener('click', function () {
			document.getElementById('float-order-btn').style.display = 'none';
		});
		</script>

	</body>
